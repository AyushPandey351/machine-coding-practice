{
  "info": {
    "name": "Licious Order Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081" },
    { "key": "orderId", "value": "1" }
  ],
  "item": [
    {
      "name": "Create Order",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/orders",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerName\": \"Test Customer\",\n  \"items\": [\n    { \"productName\": \"Fish Curry Cut\", \"pricePerUnit\": 349.00, \"quantity\": 2 }\n  ]\n}"
        }
      }
    },
    {
      "name": "Get All Orders",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/orders" }
    },
    {
      "name": "Get Order By Id",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/orders/{{orderId}}" }
    },
    {
      "name": "Get Orders By Status",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/orders/status/CREATED" }
    },
    {
      "name": "Confirm Order",
      "request": { "method": "POST", "url": "{{baseUrl}}/api/orders/{{orderId}}/confirm" }
    },
    {
      "name": "Ship Order",
      "request": { "method": "POST", "url": "{{baseUrl}}/api/orders/{{orderId}}/ship" }
    },
    {
      "name": "Deliver Order",
      "request": { "method": "POST", "url": "{{baseUrl}}/api/orders/{{orderId}}/deliver" }
    },
    {
      "name": "Cancel Order",
      "request": { "method": "POST", "url": "{{baseUrl}}/api/orders/{{orderId}}/cancel" }
    },
    {
      "name": "Deliver a CREATED order - Invalid Transition (expect 409)",
      "request": { "method": "POST", "url": "{{baseUrl}}/api/orders/{{orderId}}/deliver" }
    },
    {
      "name": "Get Order - Not Found (expect 404)",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/orders/999999" }
    },
    {
      "name": "Create Order - Validation Error (expect 400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/orders",
        "body": { "mode": "raw", "raw": "{\n  \"customerName\": \"\",\n  \"items\": []\n}" }
      }
    },
    {
      "name": "Delete Order (only allowed if CANCELLED)",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/api/orders/{{orderId}}" }
    }
  ]
}
